# Environment variables the shipped app needs (names only, never values).
# Add a variable here when release code starts reading it.
# Every integration defaults to mock/off, so the server runs with none of these set.
# Put only the lines you fill in into release/.env. An empty NAME= line sets an empty value, which is
# not the same as unset: an empty PORT, WEB_DIST or APPROVAL_TTL_SECONDS breaks the server.

# NESSIE_CUSTOMER_ID is the Nessie customer whose accounts NESSIE_MODE=live reads; `npm run nessie:seed` prints the line to paste.
# Left empty, the server looks for the customer that script creates (Demo Household) and logs a warning if none or several are found.
NESSIE_CUSTOMER_ID=

# Server (release/server)
PORT=                  # default 8787
DATA_DIR=              # default release/server/data (holds trace.jsonl)
POLICY_FILE=           # default release/server/policy/default.json
SKILLS_DIR=            # default release/server/skills
WEB_DIST=              # built web app the server serves; default release/web/dist
APPROVAL_TTL_SECONDS=  # default 120; unanswered approvals then count as denied
AUTOPILOT_MINUTES=     # run a household review (with nudges) every N minutes; default 0 = off
FINGUARD_APP_URL=      # base URL for links in texts and the printed phone link; default: this computer's LAN address; set but empty = no links
FINGUARD_INSTANCE=     # set to demo by `npm run demo`; that instance picks its phone with IMESSAGE_DEMO_PHONE

# Integrations: mock/off unless set
NESSIE_MODE=           # live | mock. live: run `npm run nessie:seed` first (demo household; ids mapped in src/bank/aliases.ts). Reads are live; FinGuard never writes to the sandbox: approved actions settle on a simulated ledger (src/bank/ledger.ts)
NESSIE_BASE_URL=       # default https://prod-api.nessieisreal.com
RAG_MODE=              # mock (default): BM25 + local embeddings | live: adds Gemini embeddings when GEMINI_API_KEY is set
AGENT_MODE=            # replay (default, rules) | claude (Anthropic model) | gemini (Gemini model); rules on any model failure
GEMINI_MODEL=          # AGENT_MODE=gemini: default gemini-3.5-flash-lite (about 1 s a call; gemini-3.8-flash takes 6-28 s; 2.5 models may 404)
GEMINI_FALLBACK_MODEL= # tried when GEMINI_MODEL answers 429; default gemini-3.5-flash (gemini-3.5-flash-lite when GEMINI_MODEL is gemini-3.5-flash); the rules brain answers after that
SCAM_LLM=              # gemini | off: Gemini second opinion on ScamShield message checks (never on transfers); default gemini when GEMINI_API_KEY is set
SCAM_LLM_MODEL=        # default gemini-3.5-flash-lite; the check times out after 4 s and the rules result stands
LLM_MODEL=             # AGENT_MODE=claude: default claude-sonnet-5-5
LLM_TIMEOUT_MS=        # per model request, default 20000
LLM_SERVER_FALLBACK=   # off = do not ask the API to retry refused requests on its fallback model

GATE_LLM=              # reserved: read into the config but not wired to SkillGate, so it has no effect
SPECTRUM_PROVIDER=     # imessage | terminal | off. imessage: approvals ("YES 4821" / "NO"), chat and nudges with STEWARD_USER_HANDLE (src/notify/server.ts)
IMESSAGE_PHONE=        # which STEWARD_USER_HANDLE entry to text at startup, by name or position (1, 2, ...); default the first
IMESSAGE_DEMO_PHONE=   # the same for the scripted demo instance (`npm run demo -- --phone NAME` sets it); falls back to IMESSAGE_PHONE

# Secrets: put them in release/.env (loaded at server start; shell variables win) or set
# them in the shell. Never committed. Never logged or returned by any route.
ANTHROPIC_API_KEY=     # AGENT_MODE=claude; without it every turn is answered by the rules
GEMINI_API_KEY=        # AGENT_MODE=gemini, SCAM_LLM second opinion, RAG_MODE=live embeddings
NESSIE_API_KEY=        # NESSIE_MODE=live
SPECTRUM_PROJECT_ID=   # Photon dashboard -> project Settings
SPECTRUM_PROJECT_SECRET=
STEWARD_USER_HANDLE=   # the customer's iMessage handle in E.164 form, exactly as registered under Users in Photon; it receives approvals. Several phones: comma-separated Name:handle@line
SPECTRUM_IMESSAGE_PHONE= # the line that user texts on (Users -> Texts on). Required on the shared pool, or sends fail with "Target not allowed for this project"
SEC_USER_AGENT=        # research pack: "Name contact@email" (SEC requires a real contact); without it SEC tools answer from a labeled cached sample (AAPL, MSFT)
